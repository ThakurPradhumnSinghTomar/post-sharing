<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-r from-[#2d193c] via-[#3c2f58] to-[#4c3f6d] flex items-center justify-center">
  <div class="bg-[#1f1b2e] text-white p-10 rounded-2xl shadow-lg w-full max-w-md">

    <h2 class="text-3xl font-bold mb-4 text-center">Create Account</h2>
    <p class="text-gray-400 text-sm mb-6 text-center">
      Already have an account?
      <a href="/login" class="text-purple-400 hover:underline">Log in</a>
    </p>

    <form class="space-y-4" action="/register" method="post">

      <input 
        type="text" 
        name="username" 
        placeholder="Username" 
        required
        class="w-full px-4 py-3 rounded-md bg-[#322b4e] placeholder-gray-400 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
      />

      <input 
        type="text" 
        name="name" 
        placeholder="Name" 
        required
        class="w-full px-4 py-3 rounded-md bg-[#322b4e] placeholder-gray-400 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
      />

      <input 
        type="number" 
        name="age" 
        placeholder="Age" 
        required
        class="w-full px-4 py-3 rounded-md bg-[#322b4e] placeholder-gray-400 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
      />

      <input 
        type="email" 
        name="email" 
        placeholder="Email" 
        required
        class="w-full px-4 py-3 rounded-md bg-[#322b4e] placeholder-gray-400 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
      />

      <input 
        type="password" 
        name="password" 
        placeholder="Password" 
        required
        class="w-full px-4 py-3 rounded-md bg-[#322b4e] placeholder-gray-400 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
      />

      <button 
        type="submit" 
        class="w-full py-3 bg-purple-600 hover:bg-purple-700 rounded-md font-semibold text-white transition"
      >
        Submit
      </button>
    </form>
  </div>
</body>
</html>
